# Configure these in app.json `extra.*` or as EXPO_PUBLIC_* env vars.
# EXPO_PUBLIC_* variables are inlined at build time and are safe to expose
# to the client (the anon key is already public by design).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-side only (set as Supabase Edge Function secrets) ---
# `supabase secrets set ANTHROPIC_API_KEY=sk-ant-...`
# ANTHROPIC_API_KEY=
