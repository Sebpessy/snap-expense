{
  "expo": {
    "name": "Snap Expense",
    "slug": "snap-expense",
    "scheme": "snapexpense",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.snapexpense.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Snap Expense uses your camera to capture receipts so we can extract and categorize expenses for you.",
        "NSPhotoLibraryUsageDescription": "Snap Expense needs photo library access to let you choose receipt images.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.snapexpense.app",
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Snap Expense to use your camera to capture receipts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Snap Expense to access your photos to pick receipts."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": ""
    }
  }
}
